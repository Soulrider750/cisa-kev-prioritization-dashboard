[Unit]
Description=Refresh the live CISA KEV dashboard
Documentation=https://github.com/Soulrider750/cisa-kev-prioritization-dashboard
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
RequiresMountsFor=/opt/kev-dashboard /etc/kev-dashboard /var/run/docker.sock

[Service]
Type=oneshot
ExecStart=/opt/kev-dashboard/current/deploy/refresh-production.sh
TimeoutStartSec=10min
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=kev-dashboard-refresh
RuntimeDirectoryMode=0700
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kev-dashboard-refresh
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
